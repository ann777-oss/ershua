# 复制为 .env 并填入真实 Key（.env 已被 gitignore，绝不入库）
DEEPSEEK_API_KEY=sk-your-key-here

# 知乎黑客松 OAuth（「审你自己的案」登录功能；不填则前端隐藏登录入口，游戏照常可玩）
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=

# 开放平台 Access Secret（developer.zhihu.com/profile 生成；调用户数据接口用，与 App Key 是两回事）
ZHIHU_ACCESS_SECRET=

# 可选：显式指定 OAuth 回调地址（不填则按请求 Origin 推导；必须与活动页面登记值完全一致）
# ZHIHU_OAUTH_REDIRECT_URI=https://your-domain/api/auth/callback

# 可选：仅用于黑客松 OAuth 回调不支持 state 时临时联调；默认不要开启
# ZHIHU_OAUTH_DISABLE_STATE_FOR_HACKATHON=true
